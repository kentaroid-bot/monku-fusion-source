# Public build-time values only. Use a dedicated Convex project.
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Set on each Convex deployment; Clerk development and production have different issuers:
# CLERK_JWT_ISSUER_DOMAIN=https://<your-clerk-frontend-api-domain>
# CLERK_SECRET_KEY (same Clerk application; account retirement; Convex only)
# Configure these separately in Convex dashboard; never NEXT_PUBLIC_:
# GEMINI_API_KEY
# GEMINI_MODEL=gemini-3.5-flash
# TYPESAFE_API_KEY
# TURNSTILE_SECRET
# TURNSTILE_HOSTNAMES=fusion.monku.ai
# STRIPE_API_KEY
# STRIPE_WEBHOOK_SECRET
# PUBLIC_SITE_ORIGIN=https://fusion.monku.ai
# Optional free-use protection in Convex (defaults: 60 free generations/day, 30 new registrations/10 min):
# FREE_DAILY_GENERATION_LIMIT=60
# SIGNUP_BURST_LIMIT=30
