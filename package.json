{
  "name": "monku-fusion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:verified": "npm run lint && npm run typecheck && npm test && npm run build",
    "start": "wrangler dev",
    "lint": "eslint",
    "test": "vitest run",
    "test:auth-input": "node scripts/check-auth-input.mjs",
    "test:account-flow": "node scripts/check-account-flow.mjs",
    "test:extension": "node scripts/check-extension.mjs",
    "test:extension-package": "node scripts/check-extension-package.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:release": "node scripts/build-extension.mjs --release",
    "check:cloudflare": "wrangler deploy --dry-run --outdir /tmp/monku-fusion-worker-check",
    "prompt:sync": "node scripts/sync-prompt.mjs",
    "test:web-experience": "node scripts/check-web-experience.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^4.18.0",
    "@clerk/react": "^6.17.0",
    "@clerk/ui": "1.34.0",
    "convex": "^1.34.0",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.59",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24"
  }
}
