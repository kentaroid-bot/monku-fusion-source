{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monku-fusion",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "fusion.monku.ai", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
